<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="root" stylesheets="@style/startStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tetris.GameOverController">
    <children>

        <Pane layoutX="20.0" layoutY="20.0" prefHeight="360.0" prefWidth="560.0" styleClass="backgroundCard">
            <children>
                <Pane layoutX="166.0" layoutY="14.0" prefHeight="70.0" prefWidth="228.0">
                    <children>
                        <Label layoutX="18.0" layoutY="9.0" styleClass="tetris-r" text="GameOver">
                            <font>
                                <Font size="42.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>

                <Button layoutX="180.0" layoutY="142.0" mnemonicParsing="false" onAction="#onRetryButtonClicked" prefHeight="38.0" prefWidth="191.0" styleClass="startButton" text="Retry" />
                <Button layoutX="182.0" layoutY="194.0" mnemonicParsing="false" onAction="#onQuitButtonClicked" prefHeight="38.0" prefWidth="191.0" styleClass="startButton" text="Quit" />
            </children>
        </Pane>

    </children>
</AnchorPane>
