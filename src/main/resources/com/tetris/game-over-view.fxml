<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="root" stylesheets="@style/startStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tetris.GameOverController">
    <children>

        <Pane layoutX="20.0" layoutY="20.0" prefHeight="360.0" prefWidth="560.0" styleClass="backgroundCard">
            <children>
                <Pane layoutX="166.0" layoutY="14.0" prefHeight="70.0" prefWidth="228.0">
                    <children>
                        <Label layoutX="18.0" layoutY="9.0" styleClass="tetris-r" text="GameOver">
                            <font>
                                <Font size="42.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>

                <Label fx:id="finalScoreLabel" alignment="CENTER" layoutX="30.0" layoutY="90.0" prefWidth="280.0" styleClass="headText" text="Score: 0" />

                <Label layoutX="30.0" layoutY="124.0" styleClass="headText" text="Name:" />
                <TextField fx:id="nameField" layoutX="30.0" layoutY="146.0" prefHeight="32.0" prefWidth="200.0" promptText="Enter your name" />
                <Button fx:id="saveButton" layoutX="240.0" layoutY="146.0" mnemonicParsing="false" onAction="#onSaveButtonClicked" prefHeight="32.0" prefWidth="80.0" styleClass="startButton" text="Save" />

                <Button layoutX="30.0" layoutY="200.0" mnemonicParsing="false" onAction="#onRetryButtonClicked" prefHeight="38.0" prefWidth="140.0" styleClass="startButton" text="Retry" />
                <Button layoutX="180.0" layoutY="200.0" mnemonicParsing="false" onAction="#onQuitButtonClicked" prefHeight="38.0" prefWidth="140.0" styleClass="startButton" text="Quit" />

                <Label layoutX="350.0" layoutY="14.0" styleClass="headText" text="Highscores" />
                <ListView fx:id="highscoreListView" layoutX="350.0" layoutY="40.0" prefHeight="300.0" prefWidth="190.0" styleClass="highscoreListView" />
            </children>
        </Pane>

    </children>
</AnchorPane>
